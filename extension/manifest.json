{
    "manifest_version": 3,
    "name": "Gemini 增强助手 - 代码折叠与侧边栏优化",
    "version": "1.0.0",
    "description": "专注提供 Gemini 侧边栏历史对话快速定位与代码块自动折叠功能",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://gemini.google.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "modules/platform.js",
                "ui/code-block-header.js",
                "ui/sidebar-optimizer.js",
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ]
}